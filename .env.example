# SQLiteデータベースの場所(通常このままでOK)
DATABASE_URL="file:./dev.db"

# AI GM機能に必要なAnthropic APIキー (https://console.anthropic.com/ で取得)
# 未設定でもAI GM以外の機能はすべて動作します
ANTHROPIC_API_KEY=""

# ログイン認証 (インターネット公開時は必須)。
# APP_PASSWORD を設定すると全ページ・全APIがパスワードで保護されます。
# ローカル開発では未設定でOK (その場合ログインなしで動作)。
APP_PASSWORD=""
# セッションCookieの署名鍵。APP_PASSWORDを設定する場合は必須。
# 長いランダム文字列を設定してください (例: openssl rand -base64 32)
AUTH_SECRET=""
