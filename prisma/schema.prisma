generator client {
  provider = "prisma-client-js"
  // native = ローカル開発。debian-openssl系 = Firebase App Hosting/Cloud Run のランタイム
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// CoC 6版探索者。8能力値は固定なので正規化カラム、技能は可変なのでJSON文字列。
// 派生値(SAN上限/HP上限/MP上限/アイデア/幸運/知識/DB)はDBに持たず lib/coc6 で毎回計算する。
model Character {
  id         String   @id @default(cuid())
  edition    String   @default("6") // "6" | "7" (SQLiteはenum非対応、zod検証)
  name       String
  playerName String?
  occupation String?
  age        Int?
  sex        String?
  imageUrl   String? // 立ち絵 (/uploads/… 相対パス)
  luck       Int? // 7版のみ: 幸運の現在値 (3d6×5)。6版はNULL (POW×5派生)
  str        Int
  con        Int
  pow        Int
  dex        Int
  app        Int
  siz        Int
  int_       Int      @map("int")
  edu        Int
  currentHp  Int
  currentMp  Int
  currentSan Int
  // { "図書館": 70, "目星": 65, ... } 技能名→現在値
  skillsJson  String   @default("{}")
  // Weapon[] 例 [{"name":"ナイフ","skillName":"ナイフ","damage":"1d4+DB"}] (weaponsSchemaで検証)
  weaponsJson String   @default("[]")
  memo       String?
  pinned     Boolean   @default(false) // お気に入りピン留め (一覧の先頭に固定)
  deletedAt  DateTime? // ゴミ箱 (非null=削除済み。一覧・検索から除外され、/trashから復元できる)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sessions        SessionCharacter[]
  aiGmMemberships AiGmSessionMember[]
}

// 人間同士の卓。status: "RECRUITING" | "ONGOING" | "FINISHED" (SQLiteはenum非対応のためString+zod検証)
model GameSession {
  id           String    @id @default(cuid())
  title        String
  scenarioName String?
  scenarioId   String?
  scenario     Scenario? @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  scheduledAt  DateTime?
  notes        String?
  status       String    @default("RECRUITING")
  combatJson   String? // 戦闘トラッカー状態 (combatStateSchemaで検証)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  characters SessionCharacter[]
  kpMessages SessionChatMessage[]
  logs       SessionLog[]
}

// 人間卓の出来事ログ(GMの自由記述メモ)。kind: "EVENT" | "NOTE" 等の分類 (String+zod検証)。
// ダイス履歴は DiceRoll.gameSessionId 側で紐付け、表示時にこれとマージする。
model SessionLog {
  id            String      @id @default(cuid())
  gameSessionId String
  gameSession   GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  kind          String      @default("EVENT")
  body          String
  createdAt     DateTime    @default(now())
}

// 人間卓のAI KP補佐チャット。ChatMessage(AI GM専用)とは分離する
// (aiGmSessionId nullable化はテーブル再構築+全クエリ修正が必要でリスクに見合わない)。
model SessionChatMessage {
  id            String      @id @default(cuid())
  gameSessionId String
  gameSession   GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  role          String // "user" | "assistant"
  contentJson   String // Anthropic content blocks 無加工 (ChatMessageと同規約)
  seq           Int
  createdAt     DateTime    @default(now())

  @@unique([gameSessionId, seq])
}

// シナリオライブラリ。source: "MANUAL" | "AI_GENERATED"
model Scenario {
  id        String   @id @default(cuid())
  title     String
  content   String // 導入+真相+手がかり+結末分岐の本文
  summary   String?
  tags      String? // カンマ区切り (SQLiteは配列非対応)
  source    String   @default("MANUAL")
  pinned    Boolean   @default(false) // お気に入りピン留め
  deletedAt DateTime? // ゴミ箱 (非null=削除済み)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gameSessions GameSession[]
  aiGmSessions AiGmSession[]
  assets       ScenarioAsset[]
}

// シナリオ付属資料。kind: "NPC" | "HANDOUT"
model ScenarioAsset {
  id         String   @id @default(cuid())
  scenarioId String
  scenario   Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  kind       String
  name       String
  content    String
  imageUrl   String? // /uploads/… 相対パス
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model SessionCharacter {
  id          String      @id @default(cuid())
  sessionId   String
  characterId String
  session     GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  character   Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([sessionId, characterId])
}

// ダイスロール履歴。source: "MANUAL" | "AI_GM"
// outcome: "CRITICAL" | "SUCCESS" | "FAILURE" | "FUMBLE" (目標値付き判定のみ)
model DiceRoll {
  id            String       @id @default(cuid())
  expression    String
  rolls         String // 個々の出目のJSON配列 例 "[3,5,1]"
  total         Int
  target        Int?
  outcome       String?
  context       String?
  skillName     String? // request_skill_check のみ設定。成長チェックの集計に使う
  characterId   String? // 誰のロールか (FKは張らない: キャラ削除で履歴を消さないため)
  characterName String? // 表示・統計用スナップショット (キャラ改名/削除に耐える)
  sanAfter      Int? // san_check時のみ。統計のSAN推移用
  source        String       @default("MANUAL")
  gameSessionId String? // 人間卓に紐付くロール (FKは張らない: characterIdと同方針。卓ログ表示用)
  aiGmSessionId String?
  aiGmSession   AiGmSession? @relation(fields: [aiGmSessionId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
}

// AI GMプレイセッション。stateJson はプレイ中のHP/MP/SANスナップショット
// (マスターシートは直接更新しない)。status: "ONGOING" | "FINISHED"
model AiGmSession {
  id                String    @id @default(cuid())
  title             String
  scenario          String // プレイ開始時のスナップショット (ライブラリ編集の影響を受けない)
  scenarioId        String? // 出所のライブラリシナリオ (任意)
  scenarioRef       Scenario? @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  status            String    @default("ONGOING")
  growthAppliedAt   DateTime? // 成長チェック反映済みガード
  // キャンペーン継続: 直前セッションのID (FKは張らない=自己参照の複雑化回避、削除に耐える)
  previousSessionId String?
  summary           String? // AI生成したセッション要約のキャッシュ (続編のあらすじに使う)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  members   AiGmSessionMember[]
  messages  ChatMessage[]
  diceRolls DiceRoll[]
}

// AI GMセッションの参加メンバー (1〜4人)。stateJsonはメンバー個別のAiGmState
model AiGmSessionMember {
  id            String      @id @default(cuid())
  aiGmSessionId String
  aiGmSession   AiGmSession @relation(fields: [aiGmSessionId], references: [id], onDelete: Cascade)
  characterId   String
  character     Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)
  stateJson     String
  position      Int // 表示順 0..3

  @@unique([aiGmSessionId, characterId])
}

// contentJson には Anthropic API の content blocks (text / thinking / tool_use / tool_result)
// をそのままシリアライズして保存する。再開時に無加工で messages 配列へ復元する。
model ChatMessage {
  id            String      @id @default(cuid())
  aiGmSessionId String
  aiGmSession   AiGmSession @relation(fields: [aiGmSessionId], references: [id], onDelete: Cascade)
  role          String // "user" | "assistant"
  contentJson   String
  seq           Int
  createdAt     DateTime    @default(now())

  @@unique([aiGmSessionId, seq])
}
