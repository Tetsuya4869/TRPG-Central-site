// Cloudflare Workers の設定。D1(データベース)とR2(立ち絵画像)のバインディングを定義する。
// database_id は `wrangler d1 create` またはダッシュボードで作成したD1のIDに置き換えること。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trpg-central",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trpg-central-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "trpg-central-uploads"
    }
  ]
}
